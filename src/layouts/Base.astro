---
import "@fontsource-variable/archivo";
import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = profile.name,
  description = profile.about[0],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Apply saved theme before paint to avoid a flash of the wrong theme.
      const saved = localStorage.getItem("theme");
      if (saved === "dark" || saved === "light")
        document.documentElement.dataset.theme = saved;
    </script>
  </head>
  <body>
    <canvas id="fieldc" aria-hidden="true"></canvas>
    <div id="cursor" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<style>
  #fieldc {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme === "dark" ||
    (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
  const cur = document.getElementById("cursor");

  // Particle flow field behind the whole page, parts around the cursor
  const fc = document.getElementById("fieldc") as HTMLCanvasElement | null;
  if (fc) {
    const fx = fc.getContext("2d")!;
    let fw = 0,
      fh = 0,
      mx = -999,
      my = -999,
      T = 0;
    const parts = Array.from({ length: 240 }, () => ({
      x: Math.random(),
      y: Math.random(),
    }));
    const size = () => {
      fw = fc.width = fc.offsetWidth;
      fh = fc.height = fc.offsetHeight;
    };
    size();
    addEventListener("resize", size);
    addEventListener("mousemove", (e) => {
      mx = e.clientX;
      my = e.clientY;
    });
    const flow = () => {
      fx.fillStyle = isDark() ? "rgba(20,27,35,0.09)" : "rgba(247,246,242,0.09)";
      fx.fillRect(0, 0, fw, fh);
      T += 0.004;
      for (const p of parts) {
        const px = p.x * fw;
        const py = p.y * fh;
        let a =
          (Math.sin(px * 0.006 + T * 3) + Math.cos(py * 0.007 - T * 2)) *
          Math.PI;
        const dx = px - mx;
        const dy = py - my;
        if (dx * dx + dy * dy < 8000) a = Math.atan2(dy, dx);
        p.x = (p.x + Math.cos(a) * 0.0016 + 1) % 1;
        p.y = (p.y + Math.sin(a) * 0.0022 + 1) % 1;
        fx.fillStyle =
          ((px + py) | 0) % 3
            ? isDark()
              ? "rgba(145,184,240,0.34)"
              : "rgba(49,90,145,0.28)"
            : isDark()
              ? "rgba(162,175,188,0.28)"
              : "rgba(117,139,165,0.28)";
        fx.fillRect(px, py, 2, 2);
      }
      if (!reduce) requestAnimationFrame(flow);
    };
    flow();
  }

  addEventListener("mousemove", (e) => {
    if (!cur) return;
    cur.style.left = e.clientX + "px";
    cur.style.top = e.clientY + "px";
  });
  document.querySelectorAll("a, button, summary").forEach((el) => {
    el.addEventListener("mouseenter", () => cur && cur.classList.add("big"));
    el.addEventListener("mouseleave", () => cur && cur.classList.remove("big"));
  });

  document.querySelectorAll(".tilt").forEach((card) => {
    card.addEventListener("mousemove", (e) => {
      if (reduce || !(e instanceof MouseEvent) || !(card instanceof HTMLElement)) return;
      const r = card.getBoundingClientRect();
      const rx = ((e.clientY - r.top) / r.height - 0.5) * -5;
      const ry = ((e.clientX - r.left) / r.width - 0.5) * 5;
      card.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg) translateY(-2px)`;
    });
    card.addEventListener("mouseleave", () => {
      if (card instanceof HTMLElement) card.style.transform = "";
    });
  });

  const cta = document.getElementById("cta");
  if (cta) {
    addEventListener("mousemove", (e) => {
      if (reduce) return;
      const r = cta.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      const d = Math.hypot(dx, dy);
      cta.style.transform =
        d < 180 ? `translate(${dx * 0.1}px, ${dy * 0.1}px)` : "";
    });
  }

  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => e.isIntersecting && e.target.classList.add("in")),
    { threshold: 0.12 },
  );
  document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
</script>
