---
import { profile } from "../data/profile";
---

<header id="about">
  <canvas id="fieldc" aria-hidden="true"></canvas>
  <div class="wrap">
    <p class="eyebrow mono">// {profile.location}</p>
    <h1 id="nm">{profile.name}</h1>
    <p class="tagline">
      I teach models to <em>see</em>, <em>imagine</em>, and occasionally
      <em>hallucinate on purpose</em>.
    </p>
    <div class="hero-row">
      <figure class="pfp">
        <canvas
          id="dn"
          role="img"
          aria-label={`Portrait of ${profile.name}, resolving from noise`}
        ></canvas>
        <figcaption>
          <button id="rerun">↻ replay</button><span>x_T → x_0</span>
        </figcaption>
      </figure>
      <div class="about-copy">
        {profile.about.map((para) => <p>{para}</p>)}
        <div class="linkrow">
          {profile.links.map((l) => <a href={l.href} rel="me noopener">{l.label} ↗</a>)}
          <a href={`mailto:${profile.email}`}>Email ↗</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  header {
    position: relative;
    padding: 4.5rem 0 3rem;
    scroll-margin-top: 4rem;
  }

  #fieldc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .eyebrow {
    position: relative;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--blue);
    font-weight: 700;
  }

  h1 {
    position: relative;
    font-family: var(--display);
    font-size: clamp(2.8rem, 9vw, 5.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-transform: uppercase;
    margin-top: 0.8rem;
  }

  .tagline {
    position: relative;
    margin-top: 1.1rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    max-width: 36ch;
  }

  .tagline em {
    font-family: var(--serif);
    color: var(--blue);
  }

  .hero-row {
    position: relative;
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 2.5rem;
    margin-top: 2.2rem;
    align-items: center;
  }

  figure.pfp {
    margin: 0;
    transform: rotate(-2deg);
  }

  figure.pfp canvas {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    image-rendering: pixelated;
    border: 2px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    background: var(--card);
  }

  figure.pfp figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  #rerun {
    font: inherit;
    cursor: pointer;
    border: 2px solid var(--ink);
    background: var(--lime);
    color: #0f0f12;
    padding: 0.3rem 0.6rem;
    box-shadow: 3px 3px 0 var(--ink);
  }

  #rerun:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  .about-copy p {
    color: var(--soft);
    max-width: 52ch;
  }

  .about-copy p + p {
    margin-top: 0.8rem;
  }

  .about-copy .linkrow {
    margin-top: 1.2rem;
  }

  @media (max-width: 640px) {
    .hero-row {
      grid-template-columns: 1fr;
    }

    figure.pfp {
      max-width: 14rem;
    }
  }
</style>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme === "dark" ||
    (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);

  // Name decodes from scrambled glyphs
  const nm = document.getElementById("nm");
  if (nm && !reduce) {
    const target = nm.textContent ?? "";
    const glyphs = "!<>-_/[]{}=+*^?#01";
    let f = 0;
    const decode = () => {
      f++;
      nm.textContent = target
        .split("")
        .map((ch, i) =>
          ch === " " ? " " : i < f / 2.2 ? ch : glyphs[Math.floor(Math.random() * glyphs.length)],
        )
        .join("");
      if (f / 2.2 < target.length) requestAnimationFrame(decode);
      else nm.textContent = target;
    };
    decode();
  }

  // Particle flow field behind the hero, parts around the cursor
  const fc = document.getElementById("fieldc") as HTMLCanvasElement | null;
  if (fc) {
    const fx = fc.getContext("2d")!;
    let fw = 0,
      fh = 0,
      mx = -999,
      my = -999,
      T = 0;
    const parts = Array.from({ length: 240 }, () => ({
      x: Math.random(),
      y: Math.random(),
    }));
    const size = () => {
      fw = fc.width = fc.offsetWidth;
      fh = fc.height = fc.offsetHeight;
    };
    size();
    addEventListener("resize", size);
    addEventListener("mousemove", (e) => {
      const r = fc.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
    });
    const flow = () => {
      fx.fillStyle = isDark() ? "rgba(19,19,23,0.09)" : "rgba(236,236,234,0.09)";
      fx.fillRect(0, 0, fw, fh);
      T += 0.004;
      for (const p of parts) {
        const px = p.x * fw;
        const py = p.y * fh;
        let a =
          (Math.sin(px * 0.006 + T * 3) + Math.cos(py * 0.007 - T * 2)) *
          Math.PI;
        const dx = px - mx;
        const dy = py - my;
        if (dx * dx + dy * dy < 8000) a = Math.atan2(dy, dx);
        p.x = (p.x + Math.cos(a) * 0.0016 + 1) % 1;
        p.y = (p.y + Math.sin(a) * 0.0022 + 1) % 1;
        fx.fillStyle =
          ((px + py) | 0) % 3
            ? isDark()
              ? "rgba(110,118,255,0.55)"
              : "rgba(36,48,232,0.5)"
            : isDark()
              ? "rgba(198,241,63,0.5)"
              : "rgba(154,190,20,0.7)";
        fx.fillRect(px, py, 2, 2);
      }
      if (!reduce) requestAnimationFrame(flow);
    };
    flow();
  }

  // Portrait denoises from static; auto-replays and has a manual replay button
  const dcv = document.getElementById("dn") as HTMLCanvasElement | null;
  if (dcv) {
    const dctx = dcv.getContext("2d")!;
    const DW = 160,
      DH = 120;
    dcv.width = DW;
    dcv.height = DH;
    let base: ImageData | null = null;
    let t = reduce ? 1 : 0;
    let running = false;
    let replayTimer: ReturnType<typeof setTimeout>;
    const frame = () => {
      if (!base) return;
      running = true;
      const out = dctx.createImageData(DW, DH);
      for (let i = 0; i < out.data.length; i += 4) {
        const n = Math.random() * 255;
        out.data[i] = base.data[i] * t + n * (1 - t);
        out.data[i + 1] = base.data[i + 1] * t + n * (1 - t);
        out.data[i + 2] = base.data[i + 2] * t + n * (1 - t);
        out.data[i + 3] = 255;
      }
      dctx.putImageData(out, 0, 0);
      if (t < 1) {
        t = Math.min(1, t + 0.008);
        requestAnimationFrame(frame);
      } else {
        running = false;
        if (!reduce) replayTimer = setTimeout(() => { t = 0; frame(); }, 5000);
      }
    };
    const img = new Image();
    img.onload = () => {
      const off = document.createElement("canvas");
      off.width = DW;
      off.height = DH;
      const octx = off.getContext("2d")!;
      octx.drawImage(img, 0, 0, DW, DH);
      base = octx.getImageData(0, 0, DW, DH);
      frame();
    };
    img.src = "/pfp.jpg";
    document.getElementById("rerun")?.addEventListener("click", () => {
      if (base && !running) {
        clearTimeout(replayTimer);
        t = 0;
        frame();
      }
    });
  }
</script>
